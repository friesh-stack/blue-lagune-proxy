{
  // Konfiguration für blue-lagune-proxy — wird von Cloudflare beim Git-Deploy gelesen
  "name": "blue-lagune-proxy",
  "main": "worker.js",
  "compatibility_date": "2026-03-10",

  // Workers-AI-Binding: legt env.AI automatisch an (ersetzt den Dashboard-Dialog)
  "ai": {
    "binding": "AI"
  },

  // Logs dauerhaft an (sonst schaltet jeder GitHub-Upload sie wieder aus)
  "observability": {
    "enabled": true
  },

  // Sprachassistent /live: Seiten, die den Assistenten nutzen dürfen
  // (der OpenAI-Schlüssel kommt NICHT hierher, sondern als Secret OPENAI_KEY ins Dashboard)
  "vars": {
    "ALLOWED_ORIGINS": "https://duenenvilla.de,https://www.duenenvilla.de,https://friesh-stack.github.io,https://myburano.com,https://xn--ostseebad-mnchgut-9zb.de,https://www.xn--ostseebad-mnchgut-9zb.de",
    "ALLOW_FILE": "1",
    // Portal-Backend (Apps Script „Portal backend“) für den Sprachassistenten der Gastgeber-Websites.
    // Dazu im Dashboard das Secret PORTAL_KEY anlegen (gleicher Wert wie Script-Property WORKER_KEY).
    "PORTAL_URL": "https://script.google.com/macros/s/AKfycbzQEO4bUXbMKPhnaymyvKKkOXet_W8XIdZSW1AzUaB0BEUZy35e9pYFUT34HBIaUy16/exec"
  }
}
